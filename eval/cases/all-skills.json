  "businessCases": {
    "discovery": {
      "title": "共働き家庭向けの食事計画・買い物支援アプリ",
      "prompt": "共働き家庭向けに、献立作成と買い物を支援するモバイルアプリを作りたいです。初期ユーザー、オンボーディング、主要体験、収益化、競合との差別化、失敗リスクを検討してください。ペルソナは30代の共働き夫婦、子ども2人、平日の夕食準備が毎日ストレス、健康・予算・好き嫌い・買い物時間を同時に考えるのが負担、という設定です。"
    },
    "planning": {
      "title": "多店舗小売向けのシフト最適化SaaS",
      "prompt": "多店舗小売向けのシフト最適化SaaSを検討しています。店長の手作業を減らしつつ、労務違反や人員不足を防ぐプロダクトとして、MVP、主要画面、技術構成、リスク、差別化を整理してください。ペルソナは多店舗展開する小売チェーンのエリアマネージャーで、欠勤・繁忙予測・労務制約を見ながら毎週シフトを組んでいます。"
    },
    "developerWorkflow": {
      "title": "Developer / PM workflow",
      "prompt": "小さな SaaS チームが、PR レビュー、リリース、QA、障害調査、学習メモの運用を AI agent skill で標準化したいです。導入順序、運用ルール、失敗リスク、証跡、チームへの説明を整理してください。"
    }
  },

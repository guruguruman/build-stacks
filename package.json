{
  "name": "build-stacks",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "APM-managed skill stacks for building, reviewing, and shipping software.",
  "scripts": {
    "build": "node scripts/apm-installed-skills-sync.mjs --write",
    "generated:verify": "node scripts/apm-installed-skills-sync.mjs --verify",
    "metadata:write": "node scripts/build-skill-metadata-sync.mjs --write",
    "metadata:verify": "node scripts/build-skill-metadata-sync.mjs --verify",
    "stack:analyze": "node packages/maintainer/.apm/skills/build-flow-organize-stack/scripts/analyze-stack.mjs",
    "stack:verify": "node packages/maintainer/.apm/skills/build-flow-organize-stack/scripts/analyze-stack.mjs --check",
    "browser:doctor": "agent-browser doctor --offline --quick",
    "browser:smoke": "node scripts/agent-browser-smoke.mjs",
    "skill:verify": "node scripts/apm-source-skills-verify.mjs",
    "apm:verify": "node scripts/apm-package-verify.mjs",
    "smoke:codex": "node scripts/apm-skill-install-smoke.mjs --target codex",
    "smoke:all": "node scripts/apm-skill-install-smoke.mjs --target all",
    "smoke:packages": "node scripts/apm-skill-install-smoke.mjs --packages",
    "quality:verify": "node scripts/release-quality-verify.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  }
}
